<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Huy hiệu hoàn thành -->
        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginTop="36dp"
            android:background="@drawable/badge_circle_emerald"
            android:padding="14dp"
            android:src="@android:drawable/checkbox_on_background"
            app:tint="#34D399" />

        <!-- Tiêu đề Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.04"
            android:text="THÔNG TIN CHI TIẾT"
            android:textColor="#F8FAFC"
            android:textSize="24sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="28dp"
            android:fontFamily="sans-serif-medium"
            android:text="Dữ liệu đăng ký đã được ghi nhận thành công"
            android:textColor="#94A3B8"
            android:textSize="14sp" />

        <!-- Thẻ CardView hiển thị chi tiết -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"
            app:cardBackgroundColor="#1E293B"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp"
            app:strokeColor="#334155"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Họ và tên -->
                <TextView
                    android:id="@+id/tvDetailName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:lineSpacingExtra="4dp"
                    android:textColor="#F8FAFC"
                    android:textSize="16sp"
                    tools:text="Họ và tên: Nguyễn Đỗ Hữu Giang" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="14dp"
                    android:background="#334155" />

                <!-- Mã sinh viên -->
                <TextView
                    android:id="@+id/tvDetailStudentId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:lineSpacingExtra="4dp"
                    android:textColor="#F8FAFC"
                    android:textSize="16sp"
                    tools:text="Mã sinh viên: 2415053122312" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="14dp"
                    android:background="#334155" />

                <!-- Lớp sinh hoạt -->
                <TextView
                    android:id="@+id/tvDetailClass"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:lineSpacingExtra="4dp"
                    android:textColor="#F8FAFC"
                    android:textSize="16sp"
                    tools:text="Lớp: 24T3" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="14dp"
                    android:background="#334155" />

                <!-- Email -->
                <TextView
                    android:id="@+id/tvDetailEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:lineSpacingExtra="4dp"
                    android:textColor="#F8FAFC"
                    android:textSize="16sp"
                    tools:text="Email: huugiang@example.com" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="14dp"
                    android:background="#334155" />

                <!-- Số điện thoại -->
                <TextView
                    android:id="@+id/tvDetailPhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:lineSpacingExtra="4dp"
                    android:textColor="#F8FAFC"
                    android:textSize="16sp"
                    tools:text="Số điện thoại: 0901234567" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Nút Quay lại -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBackToRegister"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="24dp"
            android:backgroundTint="#334155"
            android:elevation="2dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.04"
            android:stateListAnimator="@null"
            android:text="QUAY LẠI ĐĂNG KÝ"
            android:textColor="#F8FAFC"
            android:textSize="15sp"
            app:cornerRadius="14dp"
            app:icon="@android:drawable/ic_menu_revert"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            app:iconSize="18dp"
            app:iconTint="#F8FAFC"
            app:rippleColor="#475569" />

    </LinearLayout>
</ScrollView>